{"_main":{"step":"erDesign","restructuringHappened":true,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":108,"erCode":"/* Entities */\nentity SOCIETA {\n    id_societa (id),\n    nome,\n    provincia (optional),\n    regione_provenienza (optional),\n    nazione_provenienza (optional),\n    email_referente (optional),\n    telefono_referente (optional)\n}\nentity SQUADRA {\n    id_squadra (id),\n    nome\n}\nentity CATEGORIA {\n    id_categoria (id),\n    formato_gioco,\n    tipo_categoria\n}\nentity TORNEO {\n    id_torneo (id),\n    nome,\n    data_inizio,\n    data_fine,\n    luogo\n}\nentity ISCRIZIONE {\n    id_iscrizione (id),\n    data_iscrizione,\n    stato,\n    note (optional)\n}\nentity PARTECIPAZIONE {\n    id_partecipazione (id)\n}\nentity TARIFFA {\n    id_tariffa (id),\n    costo,\n    descrizione,\n    formula_roulette (optional)\n}\nentity PERSONA {\n    id_persona (id),\n    nome,\n    cognome\n}\nentity GIOCATORE {\n    data_nascita\n}\nentity GENITORE {\n    grado_parentela\n}\nentity HOTEL {\n    id_hotel (id),\n    nome,\n    indirizzo,\n    distanza,\n    telefono (optional),\n    email (optional)\n}\nentity STANZA {\n    id_stanza (id),\n    numero,\n    posti_letto\n}\n\n/* Relationships */\nrelationship CONTENERE (\n    SOCIETA: one..many,\n    SQUADRA: one..one\n)\nrelationship GIOCARE_IN (\n    CATEGORIA: one..many,\n    SQUADRA: one..one\n)\nrelationship SOTTOPORRE (\n    SQUADRA: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ISCRIVERE (\n    TORNEO: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ALLOGGIARE_PRESSO (\n    HOTEL: zero..many,\n    ISCRIZIONE: zero..one\n)\nrelationship RISERVARE (\n    ISCRIZIONE: zero..many,\n    STANZA: zero..many\n) {\n    data_inizio,\n    data_fine\n}\nrelationship APPARTENERE (\n    HOTEL: one..many,\n    STANZA: one..one\n)\nrelationship METTERE_A_DISPOSIZIONE (\n    TORNEO: zero..many,\n    STANZA: zero..many\n)\nrelationship COMPONERE_ISCRIZIONE (\n    ISCRIZIONE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PARTECIPARE_GIOCATORE (\n    GIOCATORE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship SCEGLIERE (\n    TARIFFA: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PROPORRE (\n    TORNEO: zero..many,\n    TARIFFA: one..one\n)\nrelationship OCCUPARE_GIOCATORE (\n    STANZA: zero..many,\n    GIOCATORE: zero..many\n) {\n    data_inizio,\n    data_fine\n}\nrelationship OCCUPARE_GENITORE (\n    STANZA: zero..many,\n    GENITORE: one..many\n) {\n    data_inizio,\n    data_fine,\n    con_figlio\n}\n\n/* Generalizations */\nPERSONA <= {\n    GIOCATORE,\n    GENITORE\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"SOCIETA","_x":-1392,"_y":657,"_mag":false},{"__type":"Attribute","_id":2,"_name":"id_societa","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":2,"_y":90},{"__type":"Attribute","_id":3,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-146,"_y":72},{"__type":"Attribute","_id":4,"_name":"provincia","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":-152,"_y":2},{"__type":"Attribute","_id":5,"_name":"regione_provenienza","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":-140,"_y":-59},{"__type":"Attribute","_id":6,"_name":"nazione_provenienza","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":146,"_y":63},{"__type":"Attribute","_id":7,"_name":"email_referente","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":148,"_y":-56},{"__type":"Attribute","_id":8,"_name":"telefono_referente","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":158,"_y":-2},{"__type":"Entity","_id":9,"_name":"SQUADRA","_x":-1385,"_y":207,"_mag":