\n    nome\n}\nentity CATEGORIA {\n    id_categoria (id),\n    formato_gioco,\n    tipo_categoria\n}\nentity TORNEO {\n    id_torneo (id),\n    nome,\n    data_inizio,\n    data_fine,\n    luogo\n}\nentity ISCRIZIONE {\n    id_iscrizione (id),\n    data_iscrizione,\n    stato,\n    note (optional)\n}\nentity PARTECIPAZIONE {\n    id_partecipazione (id)\n}\nentity TARIFFA {\n    id_tariffa (id),\n    costo,\n    descrizione,\n    formula_roulette (optional)\n}\nentity PERSONA {\n    id_persona (id),\n    nome,\n    cognome\n}\nentity GIOCATORE {\n    data_nascita\n}\nentity GENITORE {\n    con_figlio,\n    grado_parentela\n}\nentity HOTEL {\n    id_hotel (id),\n    nome,\n    indirizzo,\n    distanza,\n    telefono (optional),\n    email (optional)\n}\nentity STANZA {\n    id_stanza (id),\n    numero,\n    posti_letto\n}\n\n/* Relationships */\nrelationship CONTENERE (\n    SOCIETA: one..many,\n    SQUADRA: one..one\n)\nrelationship GIOCARE_IN (\n    CATEGORIA: one..many,\n    SQUADRA: one..one\n)\nrelationship SOTTOPORRE (\n    SQUADRA: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ISCRIVERE (\n    TORNEO: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ALLOGGIARE_PRESSO (\n    HOTEL: zero..many,\n    ISCRIZIONE: zero..one\n)\nrelationship RISERVARE (\n    ISCRIZIONE: zero..many,\n    STANZA: zero..many\n) {\n    data_inizio,\n    data_fine\n}\nrelationship APPARTENERE (\n    HOTEL: one..many,\n    STANZA: one..one\n)\nrelationship METTERE_A_DISPOSIZIONE (\n    TORNEO: zero..many,\n    STANZA: zero..many\n)\nrelationship COMPONERE_ISCRIZIONE (\n    ISCRIZIONE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PARTECIPARE_GIOCATORE (\n    GIOCATORE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship SCEGLIERE (\n    TARIFFA: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PROPORRE (\n    TORNEO: zero..many,\n    TARIFFA: one..one\n)\nrelationship OCCUPARE_GIOCATORE (\n    STANZA: zero..many,\n    GIOCATORE: zero..many\n) {\n    data_inizio,\n    data_fine\n}\nrelationship OCCUPARE_GENITORE (\n    STANZA: zero..many,\n    GENITORE: one..many\n) {\n    data_inizio,\n    data_fine\n}\n\n/* Generalizations */\nPERSONA <= {\n    GIOCATORE,\n    GENITORE\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"SOCIETA","_x":-1550,"_y":400,"_mag":false},{"__type":"Attribute","_id":2,"_name":"id_societa","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-152,"_y":-40},{"__type":"Attribute","_id":3,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-117,"_y":-74},{"__type":"Attribute","_id":4,"_name":"provincia","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":-63,"_y":-97},{"__type":"Attribute","_id":5,"_name":"regione_provenienza","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":-4,"_y":-129},{"__type":"Attribute","_id":6,"_name":"nazione_provenienza","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":133,"_y":-116},{"__type":"Attribute","_id":7,"_name":"email_referente","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":193,"_y":-94},{"__type":"Attribute","_id":8,"_name":"telefono_referente","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":152,"_y":-40},{"__type":"Entity","_id":9,"_name":"SQUADRA","_x":-1150,"_y":650,"_mag":false},{"__type":"Attribute","_id":10,"_name":"id_squadra","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":9,"_x":83,"_y":91},{"__type":"Attribute","_id":11,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":9,"_x":-82,"_y":91},{"__type":"Entity","_id":12,"_name":"CATEGORIA","_x":-1550,"_y":880,"_mag":false},{"__type":"Attribute","_id":13,"_name":"id_categoria","_identifier":true,"_externalId