bilita (id),\n    tipologia_camera,\n    quantita_disponibile\n}\nentity ASSEGNAZIONE_CAMERE {\n    id_assegnazione (id),\n    tipologia_camera,\n    quantita_assegnata\n}\nentity STANZA {\n    id_stanza (id),\n    numero,\n    posti_letto\n}\n\n/* Relationships */\nrelationship CONTENERE (\n    SOCIETA: one..many,\n    SQUADRA: one..one\n)\nrelationship GIOCARE_IN (\n    CATEGORIA: one..many,\n    SQUADRA: one..one\n)\nrelationship SOTTOPORRE (\n    SQUADRA: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ISCRIVERE (\n    TORNEO: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ALLOGGIARE_PRESSO (\n    HOTEL: zero..many,\n    ISCRIZIONE: zero..one\n)\nrelationship OFFRIRE_DISPONIBILITA (\n    HOTEL: zero..many,\n    DISPONIBILITA_CAMERE: one..one\n)\nrelationship RIGUARDARE_TORNEO (\n    TORNEO: zero..many,\n    DISPONIBILITA_CAMERE: one..one\n)\nrelationship RICEVERE_ASSEGNAZIONE (\n    ISCRIZIONE: zero..many,\n    ASSEGNAZIONE_CAMERE: one..one\n)\nrelationship ASSEGNAZIONE_PRESSO_HOTEL (\n    HOTEL: zero..many,\n    ASSEGNAZIONE_CAMERE: one..one\n)\nrelationship APPARTENERE (\n    HOTEL: one..many,\n    STANZA: one..one\n)\nrelationship COMPONERE_ISCRIZIONE (\n    ISCRIZIONE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PARTECIPARE_GIOCATORE (\n    GIOCATORE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship SCEGLIERE (\n    TARIFFA: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PROPORRE (\n    TORNEO: zero..many,\n    TARIFFA: one..one\n)\nrelationship OCCUPARE_GIOCATORE (\n    STANZA: zero..many,\n    PARTECIPAZIONE: zero..one\n) {\n    data_inizio,\n    data_fine\n}\nrelationship OCCUPARE_GENITORE (\n    STANZA: zero..many,\n    GENITORE: one..many\n) {\n    data_inizio,\n    data_fine\n}\n\n/* Generalizations */\nPERSONA <= {\n    GIOCATORE,\n    GENITORE\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"SOCIETA","_x":-1550,"_y":550,"_mag":false},{"__type":"Attribute","_id":2