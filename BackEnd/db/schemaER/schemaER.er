tional),\n    email_referente (optional),\n    telefono_referente (optional)\n}\nentity SQUADRA {\n    id_squadra (id),\n    nome\n}\nentity CATEGORIA {\n    id_categoria (id),\n    formato_gioco,\n    tipo_categoria\n}\nentity ISCRIZIONE {\n    id_iscrizione (id),\n    data_iscrizione,\n    stato,\n    num_giocatori_previsti (optional),\n    num_accompagnatori_previsti (optional),\n    note (optional)\n}\nentity TORNEO {\n    id_torneo (id),\n    nome,\n    data_inizio,\n    data_fine,\n    luogo,\n    giornate_giocate\n}\nentity TARIFFA {\n    id_tariffa (id),\n    costo,\n    descrizione\n}\nentity PARTECIPAZIONE {\n    id_partecipazione (id)\n}\nentity PERSONA {\n    id_persona (id),\n    nome,\n    cognome\n}\nentity GIOCATORE {\n    data_nascita\n}\nentity GENITORE\nentity HOTEL {\n    id_hotel (id),\n    nome,\n    indirizzo,\n    distanza,\n    telefono (optional),\n    email (optional)\n}\nentity DISPONIBILITA_CAMERE {\n    id_disponibilita (id),\n    tipologia_camera,\n    quantita_disponibile\n}\nentity ASSEGNAZIONE_CAMERE {\n    id_assegnazione (id),\n    tipologia_camera,\n    quantita_assegnata\n}\nentity STANZA {\n    id_stanza (id),\n    numero,\n    posti_letto\n}\n\n/* Relationships */\nrelationship CONTENERE (\n    SOCIETA: one..many,\n    SQUADRA: one..one\n)\nrelationship GIOCARE_IN (\n    CATEGORIA: one..many,\n    SQUADRA: one..one\n)\nrelationship SOTTOPORRE (\n    SQUADRA: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ISCRIVERE (\n    TORNEO: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ALLOGGIARE_PRESSO (\n    HOTEL: zero..many,\n    ISCRIZIONE: zero..one\n)\nrelationship OFFRIRE_DISPONIBILITA (\n    HOTEL: zero..many,\n    DISPONIBILITA_CAMERE: one..one\n)\nrelationship RIGUARDARE_TORNEO (\n    TORNEO: zero..many,\n    DISPONIBILITA_CAMERE: one..one\n)\nrelationship RICEVERE_ASSEGNAZIONE (\n    ISCRIZIONE: zero..many,\n    ASSEGNAZIONE_CAMERE: one..one\n)\nrelationship ASSEGNAZIONE_PRESSO_HOTEL (\n    HOTEL: zero..many,\n    ASSEGNAZIONE_CAMERE: one..one\n)\nrelationship APPARTENERE (\n    HOTEL: one..many,\n    STANZA: one..one\n)\nrelationship COMPONERE_ISCRIZIONE (\n    ISCRIZIONE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PARTECIPARE_GIOCATORE (\n    GIOCATORE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship SCEGLIERE (\n    TARIFFA: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PROPORRE (\n    TORNEO: zero..many,\n    TARIFFA: one..one\n)\nrelationship OCCUPARE_GIOCATORE (\n    STANZA: zero..many,\n    PARTECIPAZIONE: zero..one\n) {\n    data_inizio,\n    data_fine\n}\nrelationship OCCUPARE_GENITORE (\n    STANZA: zero..many,\n    GENITORE: one..many\n) {\n    data_inizio,\n    data_fine\n}\n\n/* Generalizations */\nPERSONA <= {\n    GIOCATORE,\n    GENITORE\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Table","_id":127,"_name":"SOCIETA","_x":-730,"_y":-349,"_mag":false},{"__type":"Column","_id":129,"_name":"id_societa","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":127,"_tableIndex":0},{"__type":"Column","_id":130,"_name":"nome","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":127,"_tableIndex":1},{"__type":"Column","_id":131,"_name":"provincia","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":127,"_tableIndex":2},{"__type":"Column","_id":132,"_name":"regione_provenienza","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":127,"_tableIndex":3},{"__type":"Column","_id":133,"_name":"nazione_provenienza","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":127,"_tableIndex":4},{"__type":"Column","_id":134,"_name":"email_referente","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":127,"_tableIndex":5},{"__type":"Column","_id":135,"_name":"telefono_referente","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_table