63},"248":{"__type":"Table","_id":248,"_name":"OCCUPARE_GENITORE","_x":1616,"_y":-66,"_mag":false},"249":{"__type":"Column","_id":249,"_name":"GENITORE_id_persona","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":248,"_tableIndex":0},"250":{"__type":"ForeignKey","_id":250,"_referencingColumnId":249,"_referencedColumnId":189},"251":{"__type":"Column","_id":251,"_name":"STANZA_id_stanza","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":248,"_tableIndex":1},"252":{"__type":"ForeignKey","_id":252,"_referencingColumnId":251,"_referencedColumnId":219},"253":{"__type":"Column","_id":253,"_name":"data_inizio","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":248,"_tableIndex":2},"254":{"__type":"Column","_id":254,"_name":"data_fine","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":248,"_tableIndex":3},"255":{"__type":"Column","_id":255,"_name":"HOTEL_id_hotel","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":147,"_tableIndex":8},"256":{"__type":"ForeignKey","_id":256,"_referencingColumnId":255,"_referencedColumnId":197},"257":{"__type":"Column","_id":257,"_name":"STANZA_id_stanza","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":175,"_tableIndex":4},"258":{"__type":"ForeignKey","_id":258,"_referencingColumnId":257,"_referencedColumnId":219},"259":{"__type":"Column","_id":259,"_name":"data_inizio","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":175,"_tableIndex":5},"260":{"__type":"Column","_id":260,"_name":"data_fine","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":175,"_tableIndex":6}},"sqlLinearCode":"<h3>Relational logical schema</h3>SOCIETA (<u  style=\"text-decoration: underline;\">id_societa</u>, nome, provincia*, regione_provenienza*, nazione_provenienza*, email_referente*, telefono_referente*)<br><br>\nCATEGORIA (<u  style=\"text-decoration: underline;\">id_categoria</u>, formato_gioco, tipo_categoria)<br><br>\nTORNEO (<u  style=\"text-decoration: underline;\">id_torneo</u>, nome, data_inizio, data_fine, luogo, giornate_giocate)<br><br>\nGIOCATORE (<u  style=\"text-decoration: underline;\">id_persona</u>, data_nascita, nome, cognome)<br><br>\nGENITORE (<u  style=\"text-decoration: underline;\">id_persona</u>, nome, cognome)<br><br>\nHOTEL (<u  style=\"text-decoration: underline;\">id_hotel</u>, nome, indirizzo, distanza, telefono*, email*)<br><br>\nSQUADRA (<u  style=\"text-decoration: underline;\">id_squadra</u>, nome, SOCIETA_id_societa, CATEGORIA_id_categoria)<br><br>\nISCRIZIONE (<u  style=\"text-decoration: underline;\">id_iscrizione</u>, data_iscrizione, stato, num_giocatori_previsti*, num_accompagnatori_previsti*, note*, SQUADRA_id_squadra, TORNEO_id_torneo, HOTEL_id_hotel*)<br><br>\nTARIFFA (<u  style=\"text-decoration: underline;\">id_tariffa</u>, costo, descrizione, TORNEO_id_torneo)<br><br>\nPARTECIPAZIONE (<u  style=\"text-decoration: underline;\">id_partecipazione</u>, ISCRIZIONE_id_iscrizione, GIOCATORE_id_persona, TARIFFA_id_tariffa, STANZA_id_stanza*, data_inizio*, data_fine*)<br><br>\nDISPONIBILITA_CAMERE (<u  style=\"text-decoration: underline;\">id_disponibilita</u>, tipologia_camera, quantita_disponibile, HOTEL_id_hotel, TORNEO_id_torneo)<br><br>\nASSEGNAZIONE_CAMERE (<u  style=\"text-decoration: underline;\">id_assegnazione</u>, tipologia_camera, quantita_assegnata, ISCRIZIONE_id_iscrizione, HOTEL_id_hotel)<br><br>\nSTANZA (<u  style=\"text-decoration: underline;\">id_stanza</u>, numero, posti_letto, HOTEL_id_hotel)<br><br>\nOCCUPARE_GENITORE (<u  style=\"text-decoration: underline;\">GENITORE_id_persona</u>, <u  style=\"text-decoration: underline;\">STANZA_id_stanza</u>, data_inizio, data_fine)<br><br>\n\n<br><h3>Referential integrity constraints</h3>\n\n\n\n\n\nSQUADRA (SOCIETA_id_societa)  REFERENCES SOCIETA  (id_societa)<br><br>SQUADRA (CATEGORIA_id_categoria)  REFERENCES CATEGORIA  (id_categoria)<br><br>\nISCRIZIONE (SQUADRA_id_squadra)  REFERENCES SQUADRA  (id_squadra)<br><br>ISCRIZIONE (TORNEO_id_torneo)  REFERENCES TORNEO  (id_torneo)<br><br>ISCRIZIONE (HOTEL_id_hotel)  REFERENCES HOTEL  (id_hotel)<br><br>\nTARIFFA (TORNEO_id_torneo)  REFERENCES TORNEO  (id_torneo)<br><br>\nPARTECIPAZIONE (ISCRIZIONE_id_iscrizione)  REFERENCES ISCRIZIONE  (id_iscrizione)<br><br>PARTECIPAZIONE (GIOCATORE_id_persona)  REFERENCES GIOCATORE  (id_persona)<br><br>PARTECIPAZIONE (TARIFFA_id_tariffa)  REFERENCES TARIFFA  (id_tariffa)<br><br>PARTECIPAZIONE (STANZA_id_stanza)  REFERENCES STANZA  (id_stanza)<br><br>\nDISPONIBILITA_CAMERE (HOTEL_id_hotel)  REFERENCES HOTEL  (id_hotel)<br><br>DISPONIBILITA_CAMERE (TORNEO_id_torneo)  REFERENCES TORNEO  (id_torneo)<br><br>\nASSEGNAZIONE_CAMERE (ISCRIZIONE_id_iscrizione)  REFERENCES ISCRIZIONE  (id_iscrizione)<br><br>ASSEGNAZIONE_CAMERE (HOTEL_id_hotel)  REFERENCES HOTEL  (id_hotel)<br><br>\nSTANZA (HOTEL_id_hotel)  REFERENCES HOTEL  (id_hotel)<br><br>\nOCCUPARE_GENITORE (GENITORE_id_persona)  REFERENCES GENITORE  (id_persona)<br><br>OCCUPARE_GENITORE (STANZA_id_stanza)  REFERENCES STANZA  (id_stanza)<br><br>"},"edited":true,"sceneResetToken":1795260265646,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":null,"showNotesDataMenu":false}