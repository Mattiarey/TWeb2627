":false,"_unique":false,"_nullable":false,"_tableId":248,"_tableIndex":3},"255":{"__type":"Column","_id":255,"_name":"HOTEL_id_hotel","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":147,"_tableIndex":8},"256":{"__type":"ForeignKey","_id":256,"_referencingColumnId":255,"_referencedColumnId":197},"257":{"__type":"Column","_id":257,"_name":"STANZA_id_stanza","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":175,"_tableIndex":4},"258":{"__type":"ForeignKey","_id":258,"_referencingColumnId":257,"_referencedColumnId":219},"259":{"__type":"Column","_id":259,"_name":"data_inizio","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":175,"_tableIndex":5},"260":{"__type":"Column","_id":260,"_name":"data_fine","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":175,"_tableIndex":6}},"sqlLinearCode":""},"edited":false,"sceneResetToken":1795260120861,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showOneToManyTypeBRelationshipMenu":false,"showOneToOneTypeBRelationshipMenu":false,"showOneToOneTypeCRelationshipMenu":false,"showExportMenu":false,"showNotes":false},"schemaDesign":{"model":{"uid":261,"erCode":"/* Entities */\nentity SOCIETA {\n    id_societa (id),\n    nome,\n    provincia (optional),\n    regione_provenienza (optional),\n    nazione_provenienza (optional),\n    email_referente (optional),\n    telefono_referente (optional)\n}\nentity SQUADRA {\n    id_squadra (id),\n    nome\n}\nentity CATEGORIA {\n    id_categoria (id),\n    formato_gioco,\n    tipo_categoria\n}\nentity ISCRIZIONE {\n    id_iscrizione (id),\n    data_iscrizione,\n    stato,\n    num_giocatori_previsti (optional),\n    num_accompagnatori_previsti (optional),\n    note (optional)\n}\nentity TORNEO {\n    id_torneo (id),\n    nome,\n    data_inizio,\n    data_fine,\n    luogo,\n    giornate_giocate\n}\nentity TARIFFA {\n    id_tariffa (id),\n    costo,\n    descrizione\n}\nentity PARTECIPAZIONE {\n    id_partecipazione (id)\n}\nentity PERSONA {\n    id_persona (id),\n    nome,\n    cognome\n}\nentity GIOCATORE {\n    data_nascita\n}\nentity GENITORE\nentity HOTEL {\n    id_hotel (id),\n    nome,\n    indirizzo,\n    distanza,\n    telefono (optional),\n    email (optional)\n}\nentity DISPONIBILITA_CAMERE {\n    id_disponibilita (id),\n    tipologia_camera,\n    quantita_disponibile\n}\nentity ASSEGNAZIONE_CAMERE {\n    id_assegnazione (id),\n    tipologia_camera,\n    quantita_assegnata\n}\nentity STANZA {\n    id_stanza (id),\n    numero,\n    posti_letto\n}\n\n/* Relationships */\nrelationship CONTENERE (\n    SOCIETA: one..many,\n    SQUADRA: one..one\n)\nrelationship GIOCARE_IN (\n    CATEGORIA: one..many,\n    SQUADRA: one..one\n)\nrelationship SOTTOPORRE (\n    SQUADRA: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ISCRIVERE (\n    TORNEO: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ALLOGGIARE_PRESSO (\n    HOTEL: zero..many,\n    ISCRIZIONE: zero..one\n)\nrelationship OFFRIRE_DISPONIBILITA (\n    HOTEL: zero..many,\n    DISPONIBILITA_CAMERE: one..one\n)\nrelationship RIGUARDARE_TORNEO (\n    TORNEO: zero..many,\n    DISPONIBILITA_CAMERE: one..one\n)\nrelationship RICEVERE_ASSEGNAZIONE (\n    ISCRIZIONE: zero..many,\n    ASSEGNAZIONE_CAMERE: one..one\n)\nrelationship ASSEGNAZIONE_PRESSO_HOTEL (\n    HOTEL: zero..many,\n    ASSEGNAZIONE_CAMERE: one..one\n)\nrelationship APPARTENERE (\n    HOTEL: one..many,\n    STANZA: one..one\n)\nrelationship COMPONERE_ISCRIZIONE (\n    ISCRIZIONE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PARTECIPARE_GIOCATORE (\n    GIOCATORE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship SCEGLIERE (\n    TARIFFA: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PROPORRE (\n    TORNEO: zero..many,\n    TARIFFA: one..one\n)\nrelationship OCCUPARE_GIOCATORE (\n    STANZA: zero..many,\n    PARTECIPAZIONE: zero..one\n) {\n    data_inizio,\n    data_fine\n}\nrelationship OCCUPARE_GENITORE (\n    STANZA: zero..many,\n    GENITORE: one..many\n) {\n    data_inizio,\n    data_fine\n}\n\n/* Generalizations */\nPERSONA <= {\n    GIOCATORE,\n    GENITORE\n} (total, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE SOCIETA (\n    id_societa INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    provincia INTEGER,\n    regione_provenienza INTEGER,\n    nazione_provenienza INTEGER,\n    email_referente INTEGER,\n    telefono_referente INTEGER,\n    PRIMARY KEY (id_societa)\n);\nCREATE TABLE CATEGORIA (\n    id_categoria INTEGER NOT NULL,\n    formato_gioco INTEGER NOT NULL,\n    tipo_categoria INTEGER NOT NULL,\n    PRIMARY KEY (id_categoria)\n);\nCREATE TABLE TORNEO (\n    id_torneo INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    data_inizio INTEGER NOT NULL,\n    data_fine INTEGER NOT NULL,\n    luogo INTEGER NOT NULL,\n    giornate_giocate INTEGER NOT NULL,\n    PRIMARY KEY (id_torneo)\n);\nCREATE TABLE GIOCATORE (\n    id_persona INTEGER NOT NULL,\n    data_nascita INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    cognome INTEGER NOT NULL,\n    PRIMARY KEY (id_persona)\n);\nCREATE TABLE GENITORE (\n    id_persona INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    cognome INTEGER NOT NULL,\n    PRIMARY KEY (id_persona)\n);\nCREATE TABLE HOTEL (\n    id_hotel INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    indirizzo INTEGER NOT NULL,\n    distanza INTEGER NOT NULL,\n    telefono INTEGER,\n    email INTEGER,\n    PRIMARY KEY (id_hotel)\n);\nCREATE TABLE SQUADRA (\n    id_squadra INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    SOCIETA_id_societa INTEGER NOT NULL,\n    CATEGORIA_id_categoria INTEGER NOT NULL,\n    PRIMARY KEY (id_squadra),\n    FOREIGN KEY (SOCIETA_id_societa) REFERENCES SOCIETA (id_societa)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (CATEGORIA_id_categoria) REFERENCES CATEGORIA (id_categoria)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE ISCRIZIONE (\n    id_iscrizione INTEGER NOT NULL,\n    data_iscrizione INTEGER NOT NULL,\n    stato INTEGER NOT NULL,\n    num_giocatori_previsti INTEGER,\n    num_accompagnatori_previsti INTEGER,\n    note INTEGER,\n    SQUADRA_id_squadra INTEGER NOT NULL,\n    TORNEO_id_torneo INTEGER NOT NULL,\n    HOTEL_id_hotel INTEGER,\n    PRIMARY KEY (id_iscrizione),\n    FOREIGN KEY (SQUADRA_id_squadra) REFERENCES SQUADRA (id_squadra)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (TORNEO_id_torneo) REFERENCES TORNEO (id_torneo)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (HOTEL_id_hotel) REFERENCES HOTEL (id_hotel)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE TARIFFA (\n    id_tariffa INTEGER NOT NULL,\n    costo INTEGER NOT NULL,\n    descrizione INTEGER NOT NULL,\n    TORNEO_id_torneo INTEGER NOT NULL,\n    PRIMARY KEY (id_tariffa),\n    FOREIGN KEY (TORNEO_id_torneo) REFERENCES TORNEO (id_torneo)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE PARTECIPAZIONE (\n    id_partecipazione INTEGER NOT NULL,\n    ISCRIZIONE_id_iscrizione INTEGER NOT NULL,\n    GIOCATORE_id_persona INTEGER NOT NULL,\n    TARIFFA_id_tariffa INTEGER NOT NULL,\n    STANZA_id_stanza INTEGER,\n    data_inizio INTEGER,\n    data_fine INTEGER,\n    PRIMARY KEY (id_partecipazione),\n    FOREIGN KEY (ISCRIZIONE_id_iscrizione) REFERENCES ISCRIZIONE (id_iscrizione)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (GIOCATORE_id_persona) REFERENCES GIOCATORE (id_persona)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (TARIFFA_id_tariffa) REFERENCES TARIFFA (id_tariffa)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (STANZA_id_stanza) REFERENCES STANZA (id_stanza)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE DISPONIBILITA_CAMERE (\n    id_disponibilita INTEGER NOT NULL,\n    tipologia_camera INTEGER NOT NULL,\n    quantita_disponibile INTEGER NOT NULL,\n    HOTEL_id_hotel INTEGER NOT NULL,\n    TORNEO_id_torneo INTEGER NOT NULL,\n    PRIMARY KEY (id_disponibilita),\n    FOREIGN KEY (HOTEL_id_hotel) REFERENCES HOTEL (id_hotel)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (TORNEO_id_torneo) REFERENCES TORNEO (id_torneo)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE ASSEGNAZIONE_CAMERE (\n    id_assegnazione INTEGER NOT NULL,\n    tipologia_camera INTEGER NOT NULL,\n    quantita_assegnata INTEGER NOT NULL,\n    ISCRIZIONE_id_iscrizione INTEGER NOT NULL,\n    HOTEL_id_hotel INTEGER NOT NULL,\n    PRIMARY KEY (id_assegnazione),\n    FOREIGN KEY (ISCRIZIONE_id_iscrizione) REFERENCES ISCRIZIONE (id_iscrizione)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (HOTEL_id_hotel) REFERENCES HOTEL (id_hotel)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE STANZA (\n    id_stanza INTEGER NOT NULL,\n    numero INTEGER NOT NULL,\n    posti_letto INTEGER NOT NULL,\n    HOTEL_id_hotel INTEGER NOT NULL,\n    PRIMARY KEY (id_stanza),\n    FOREIGN KEY (HOTEL_id_hotel) REFERENCES HOTEL (id_hotel)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE OCCUPARE_GENITORE (\n    GENITORE_id_persona INTEGER NOT NULL,\n    STANZA_id_stanza INTEGER NOT NULL,\n    data_inizio INTEGER NOT NULL,\n    data_fine INTEGER NOT NULL,\n    PRIMARY KEY (GENITORE_id_persona, STANZA_id_stanza),\n    FOREIGN KEY (GENITORE_id_persona) REFERENCES GENITORE (id_persona)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (STANZA_id_stanza) REFERENCES STANZA (id_stanza)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);","itemsArray":[{"__type":"Table","_id":127,"_name":"SOCIETA","_x":-730,"_y":-349,"_mag":false},{"__type":"Column","_id":129,"_name":"id_societa","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":127,"_tableIndex":0},{"__type":"Column","_id":130,"_name":"nome","_type":"i