{"_main":{"step":"erDesign","restructuringHappened":true,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":121,"erCode":"/* Entities */\nentity SOCIETA {\n    id_societa (id),\n    nome,\n    provincia (optional),\n    regione_provenienza (optional),\n    nazione_provenienza (optional),\n    email_referente (optional),\n    telefono_referente (optional)\n}\nentity SQUADRA {\n    id_squadra (id),\n    nome\n}\nentity CATEGORIA {\n    id_categoria (id),\n    formato_gioco,\n    tipo_categoria\n}\nentity ISCRIZIONE {\n    id_iscrizione (id),\n    data_iscrizione,\n    stato,\n    num_giocatori_previsti (optional),\n    num_accompagnatori_previsti (optional),\n    note (optional)\n}\nentity TORNEO {\n    id_torneo (id),\n    nome,\n    data_inizio,\n    data_fine,\n    luogo,\n    giornate_giocate\n}\nentity TARIFFA {\n    id_tariffa (id),\n    costo,\n    descrizione\n}\nentity PARTECIPAZIONE {\n    id_partecipazione (id)\n}\nentity PERSONA {\n    id_persona (id),\n    nome,\n    cognome\n}\nentity GIOCATORE {\n    data_nascita\n}\nentity GENITORE\nentity HOTEL {\n    id_hotel (id),\n    nome,\n    indirizzo,\n    distanza,\n    telefono (optional),\n    email (optional)\n}\nentity DISPONIBILITA_CAMERE {\n    id_disponibilita (id),\n    tipologia_camera,\n    quantita_disponibile\n}\nentity ASSEGNAZIONE_CAMERE {\n    id_assegnazione (id),\n    tipologia_camera,\n    quantita_assegnata\n}\nentity STANZA {\n    id_stanza (id),\n    numero,\n    posti_letto\n}\n\n/* Relationships */\nrelationship CONTENERE (\n    SOCIETA: one..many,\n    SQUADRA: one..one\n)\nrelationship GIOCARE_IN (\n    CATEGORIA: one..many,\n    SQUADRA: one..one\n)\nrelationship SOTTOPORRE (\n    SQUADRA: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ISCRIVERE (\n    TORNEO: zero..many,\n    ISCRIZIONE: one..one\n)\nrelationship ALLOGGIARE_PRESSO (\n    HOTEL: zero..many,\n    ISCRIZIONE: zero..one\n)\nrelationship OFFRIRE_DISPONIBILITA (\n    HOTEL: zero..many,\n    DISPONIBILITA_CAMERE: one..one\n)\nrelationship RIGUARDARE_TORNEO (\n    TORNEO: zero..many,\n    DISPONIBILITA_CAMERE: one..one\n)\nrelationship RICEVERE_ASSEGNAZIONE (\n    ISCRIZIONE: zero..many,\n    ASSEGNAZIONE_CAMERE: one..one\n)\nrelationship ASSEGNAZIONE_PRESSO_HOTEL (\n    HOTEL: zero..many,\n    ASSEGNAZIONE_CAMERE: one..one\n)\nrelationship APPARTENERE (\n    HOTEL: one..many,\n    STANZA: one..one\n)\nrelationship COMPONERE_ISCRIZIONE (\n    ISCRIZIONE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PARTECIPARE_GIOCATORE (\n    GIOCATORE: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship SCEGLIERE (\n    TARIFFA: zero..many,\n    PARTECIPAZIONE: one..one\n)\nrelationship PROPORRE (\n    TORNEO: zero..many,\n    TARIFFA: one..one\n)\nrelationship OCCUPARE_GIOCATORE (\n    STANZA: zero..many,\n    PARTECIPAZIONE: zero..one\n) {\n    data_inizio,\n    data_fine\n}\nrelationship OCCUPARE_GENITORE (\n    STANZA: zero..many,\n    GENITORE: one..many\n) {\n    data_inizio,\n    data_fine\n}\n\n/* Generalizations */\nPERSONA <= {\n    GIOCATORE,\n    GENITORE\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"SOCIETA","_x":-1550,"_y":550,"_mag":false},{"__type":"Attribute","_id":2,"_name":"id_societa","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":152,"_y":40},{"__type":"Attribute","_id":3,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":117,"_y":74},{"__type":"Attribute","_id":4,"_name":"provincia","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":39,"_y":120},{"__type":"Attribute","_id":5,"_name":"regione_provenienza","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":-103,"_y":112},{"__type":"Attribute","_id":6,"_name":"nazione_provenienza","_identifier":false,"_externalIdentifier