{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":106,"erCode":"/* Entities */\nentity HOTEL {\n    id_hotel (id),\n    nome,\n    indirizzo,\n    distanza\n}\nentity SQUADRA {\n    id_squadra (id),\n    nome\n}\nentity SOCIETA {\n    id_societa (id),\n    nome,\n    regione_provenienza (optional),\n    nazione (optional)\n}\nentity GIOCATORE\nentity STANZA {\n    numero,\n    posti_letto,\n    id_stanza (id)\n}\nentity PERSONA {\n    id_persona (id),\n    nome,\n    cognome\n}\nentity GENITORE {\n    con_figlio\n}\nentity TORNEO {\n    id_torneo (id),\n    nome,\n    data_inizio,\n    data_fine\n}\nentity TARIFFA {\n    costo,\n    descrizione\n}\nentity CATEGORIA {\n    nome (id),\n    formato_gioco\n}\nentity ISCRIZIONE {\n    id_iscrizione (id)\n}\n\n/* Relationships */\nrelationship CONTENERE (\n    SOCIETA: one..many,\n    SQUADRA: one..one\n)\nrelationship AVERE (\n    SQUADRA: one..many,\n    GIOCATORE: zero..many\n)\nrelationship FORNIRE (\n    HOTEL: zero..many,\n    STANZA: zero..many,\n    TORNEO: zero..many\n)\nrelationship OCCUPARE (\n    STANZA: zero..many,\n    PERSONA: zero..many\n) {\n    data_inizio,\n    data_fine\n}\nrelationship PROPORRE (\n    TORNEO: one..many,\n    TARIFFA: one..one external\n)\nrelationship SCEGLIERE (\n    GIOCATORE: one..many,\n    TARIFFA: zero..many\n)\nrelationship GIOCARE_IN (\n    CATEGORIA: one..many,\n    SQUADRA: one..one\n)\nrelationship ISCRIVERE (\n    ISCRIZIONE: one..one,\n    TORNEO: one..many\n)\nrelationship SOTTOPORRE (\n    ISCRIZIONE: one..one,\n    SQUADRA: zero..many\n)\nrelationship RISERVARE (\n    ISCRIZIONE: one..many,\n    STANZA: zero..many\n)\nrelationship COMPORRE (\n    GIOCATORE: zero..many,\n    ISCRIZIONE: zero..many\n)\n\n/* Generalizations */\nPERSONA <= {\n    GIOCATORE,\n    GENITORE\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Enti